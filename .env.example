# Copy to .env.local for docker compose, or .env for bare `npm run dev`.
# Every variable here is validated by packages/../apps/api/src/config/config.schema.ts.
# The process refuses to start if one is missing or malformed.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- datastores -------------------------------------------------------------
# Host values for running the API outside compose. Inside compose these are
# overridden to the service names (postgres / redis) by docker-compose.yml.
DATABASE_URL=postgres://nutricheck:local@localhost:5432/nutricheck
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# --- auth -------------------------------------------------------------------
# Generate real ones with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- AI ---------------------------------------------------------------------
# Never shipped to the device. Leave blank until M2 — the API boots without it
# in development and only the resolver route is disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_MS=8000
RESOLVE_DAILY_QUOTA=50
RESOLVE_USER_DAILY_SPEND_USD=1.00

# --- embeddings -------------------------------------------------------------
# Baked into the image at /app/model in production. Empty locally = search
# falls back to trigram only, which is enough for M0.
MODEL_PATH=

# --- telemetry --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nutricheck-api
