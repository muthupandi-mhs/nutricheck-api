# Staging environment. Copy to .env.staging ON THE STAGING SERVER:
#
#   cp .env.staging.example .env.staging
#
# That is the filename docker/docker-compose.staging.yml reads. Production gets
# its own pair when it lands -- .env.prod.example -> .env.prod, read by
# docker-compose.prod.yml.
#
# Staging secrets are still real secrets. They are not shared with production
# and not reused anywhere, but a staging box on a public IP is as reachable as a
# production one, and the difference between the two is what the database holds,
# not how hard it is to break into.

# --- compose-level (read by docker-compose.staging.yml itself) ---------------
# Generate the password -- do NOT ship the placeholder:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 40
POSTGRES_USER=nutricheck
POSTGRES_PASSWORD=
POSTGRES_DB=nutricheck

# The hostname Caddy serves. Staging rarely justifies buying a domain, and two
# options avoid it:
#
#   1. sslip.io  -- RECOMMENDED. A public DNS service that resolves any IP
#      embedded in the hostname, so 43-205-194-160.sslip.io resolves to
#      43.205.194.160 with nothing to configure. Because it is a genuinely
#      resolvable name, Caddy gets a real Let's Encrypt certificate for it and
#      staging speaks HTTPS. That matters: Android and iOS block cleartext HTTP
#      by default, so an http:// staging API means weakening the mobile app's
#      network config just to test against it.
#
#      DOMAIN=<your-ip-with-dashes>.sslip.io
#
#   2. A bare port -- no certificate at all, plain HTTP on port 80. Simplest
#      possible, and fine if nothing but curl talks to this box.
#
#      DOMAIN=:80
#
# Swap the IP below for this instance's own. If the instance IP is not STATIC,
# a reboot changes it and this hostname stops resolving with it.
DOMAIN=43-205-194-160.sslip.io

# Let's Encrypt sends certificate expiry warnings here. Ignored when DOMAIN is
# a bare port, but compose still requires it to be set.
ACME_EMAIL=

# Set to pull a prebuilt image instead of building on the box.
# IMAGE=docker.io/youruser/nutricheck-api:staging

# --- application ------------------------------------------------------------
# NODE_ENV stays `production` on a staging box, and that is not a mistake.
# config.schema.ts accepts only development | test | production, and the value
# selects build behaviour -- optimised, no dev-only branches -- not which
# environment this is. Which environment it is, is which machine it is.
NODE_ENV=production
PORT=3000

# debug rather than info: the whole point of staging is seeing what happened.
LOG_LEVEL=debug

DATABASE_POOL_MAX=10

# --- auth -------------------------------------------------------------------
# REQUIRED. Minimum 32 characters, enforced at boot. Two DIFFERENT values --
# reusing one means a stolen access token can be replayed as a refresh token.
#   openssl rand -base64 48 | tr -d '/+='
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Shorter than production on purpose: a 30-day refresh token issued by a staging
# box is a 30-day credential lying around a machine nobody is watching.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- AI ---------------------------------------------------------------------
# Leave blank and the API still boots -- only /v1/resolve is disabled. M1 core
# is fully usable with zero AI, so staging without a key is a real environment,
# not a broken one. Add a key only when testing the resolver itself.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_MS=8000

# Lower than production. Staging is where a client bug loops, and the ceiling
# should be small enough that discovering it costs pennies.
RESOLVE_DAILY_QUOTA=20
RESOLVE_USER_DAILY_SPEND_USD=0.25

# --- speech transcription (optional) ----------------------------------------
# Without a key /v1/transcribe returns 503 and the app stays on-device.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
TRANSCRIBE_MAX_BYTES=2000000

# --- embeddings -------------------------------------------------------------
# Empty = trigram-only search, the current state of the corpus
# (food_embeddings holds 0 rows). Leave blank until M2.
MODEL_PATH=

# --- telemetry --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nutricheck-api-staging
