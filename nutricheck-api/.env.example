# Copy to .env.local for docker compose, or .env for bare `npm run dev`.
# Every variable here is validated by packages/../apps/api/src/config/config.schema.ts.
# The process refuses to start if one is missing or malformed.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- datastores -------------------------------------------------------------
# Host values for running the API outside compose. Inside compose these are
# overridden to the service names (postgres / redis) by docker-compose.yml.
DATABASE_URL=postgres://nutricheck:local@localhost:5432/nutricheck
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# --- auth -------------------------------------------------------------------
# Generate real ones with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- AI ---------------------------------------------------------------------
# Never shipped to the device. Leave blank until M2 — the API boots without it
# in development and only the resolver route is disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_MS=8000
RESOLVE_DAILY_QUOTA=50
RESOLVE_USER_DAILY_SPEND_USD=1.00

# --- embeddings -------------------------------------------------------------
# Baked into the image at /app/model in production. Empty locally = search
# falls back to trigram only, which is enough for M0.
MODEL_PATH=

# --- telemetry --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nutricheck-api

# --- provider selection -----------------------------------------------------
# 'anthropic' is the locked decision in PLAN.md §3. 'openai-compatible' covers
# anything speaking that wire format -- OpenAI, Groq, Together, OpenRouter,
# DeepSeek, Fireworks, vLLM, Ollama -- via AI_BASE_URL.
#
# Put real keys in .env.local (gitignored), never here.
AI_PROVIDER=anthropic

# Used only when AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Leave blank for OpenAI itself. Examples:
#   https://api.groq.com/openai/v1
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1        (Ollama)
AI_BASE_URL=
# Set false for a provider that does not honour json_schema strict mode. Doing
# so loses the guarantee that a food id cannot be invented, so it is opt-out.
AI_STRICT_SCHEMA=true

# Required only for a model with no built-in rate entry, so the spend ceiling
# cannot silently read zero.
AI_INPUT_USD_PER_MTOK=
AI_OUTPUT_USD_PER_MTOK=

# ── Speech transcription (optional) ──────────────────────────────────────────
# A FALLBACK for dictation, not the primary path. On-device recognition stays
# the default: free, private, works offline. This exists because Android's
# offline models are poor at Tamil and at code-switched Tanglish.
#
# Without a key /v1/transcribe returns 503 and the app simply stays on-device —
# the same degradation the resolver has without an AI key.
# The real key belongs in .env.local, never here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Decoded audio ceiling in bytes. A dictated meal is seconds long; a generous
# cap is a way to be billed for somebody else's podcast.
TRANSCRIBE_MAX_BYTES=2000000

# --- Google sign-in (optional) ----------------------------------------------
# Comma-separated OAuth client IDs a Google ID token may be issued for. This is
# the audience check, and it is the only thing that makes verification mean
# anything: a signature proves Google minted the token, not that Google minted
# it for US. Without it, any app's valid Google token signs its holder in here.
#
# The ANDROID app's token carries the WEB client ID -- that is what
# google-signin's webClientId selects. The Android OAuth client (the one bound
# to your SHA-1) still has to exist in the same Google Cloud project, but its ID
# never appears in a token and does not belong here. An iOS build later appends
# its own iOS client ID to this list.
#
# Unset means /v1/auth/google answers 503 and the app stays on email + password,
# the same degradation a missing AI key produces. It does NOT fall back to
# accepting anything.
GOOGLE_OAUTH_CLIENT_IDS=
