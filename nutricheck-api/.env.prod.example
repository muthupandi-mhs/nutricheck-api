# Production environment. Copy to .env.prod ON THE PRODUCTION SERVER:
#
#   cp .env.prod.example .env.prod
#
# Production is not deployed yet -- staging came first. When it lands it needs
# docker/docker-compose.prod.yml beside the staging one; see that file for why
# an override is preferable to a copy. Meanwhile .env.staging.example is the
# counterpart that IS in use.
#
# Never commit the filled copy: .gitignore covers .env.prod, and that entry is
# the only thing standing between a real JWT secret and the public history of
# this repository.
#
# This file is NOT .env.example. The dev file ships working defaults so a
# checkout boots; every secret here has to be generated. Loading .env.example
# in production would ship the committed dev JWT secrets, which is exactly what
# its own comments warn against.
#
# Only four variables have no default in config.schema.ts: DATABASE_URL,
# REDIS_URL, and the two JWT secrets. The compose file supplies the first two
# from the POSTGRES_* values below, so they are absent here on purpose --
# `environment:` in compose takes precedence over `env_file:` anyway.

# --- compose-level (read by docker-compose.prod.yml itself) -----------------
# These build DATABASE_URL and name the Postgres role. Generate the password:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 40
POSTGRES_USER=nutricheck
POSTGRES_PASSWORD=
POSTGRES_DB=nutricheck

# The domain Caddy will request a certificate for. Must already have an A
# record pointing at this instance's static IP, or issuance fails.
DOMAIN=api.example.com
# Let's Encrypt sends expiry warnings here. A real address you read.
ACME_EMAIL=

# Set to pull a prebuilt image instead of building on the box. Leave unset to
# build locally (see DEPLOY.md -- on 4 GB this needs swap enabled first).
# IMAGE=docker.io/youruser/nutricheck-api:1.0.0

# --- application ------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
DATABASE_POOL_MAX=10

# Leave UNSET for a managed database (RDS, Neon, Crunchy): unset means TLS is
# required whenever NODE_ENV=production, with certificate verification, which is
# what you want across a network you do not control.
#
# Set to false ONLY if production runs Postgres as a container on the same host,
# the way staging does -- that server speaks no TLS and the pool is rejected
# outright. See .env.staging.example for the full symptom.
# DATABASE_SSL=false

# --- auth -------------------------------------------------------------------
# REQUIRED. Minimum 32 characters, enforced at boot. Generate two DIFFERENT
# ones -- reusing a single secret for both means a stolen access token can be
# replayed as a refresh token:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- AI ---------------------------------------------------------------------
# Leave blank to deploy without the resolver. The API boots fine and only
# /v1/resolve is disabled -- the app stays fully usable, since M1 core works
# with zero AI.
# openai-compatible matches what the project actually runs (.env.local), not the
# AI_PROVIDER=anthropic recorded in .env.example and PLAN.md 3. If production is
# meant to go back to Anthropic, that is a decision to make deliberately here --
# not by inheriting a default nobody has used.
AI_PROVIDER=openai-compatible
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=
AI_STRICT_SCHEMA=true
# gpt-4o-mini is in cost.ts RATES, so these stay empty. Required only for a
# model with no built-in entry, or the spend ceiling reads zero.
AI_INPUT_USD_PER_MTOK=
AI_OUTPUT_USD_PER_MTOK=

# Unused while AI_PROVIDER=openai-compatible.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_MS=8000

# Cost ceilings. These are the only thing between a loop in a client and a
# four-figure bill, so set them before the key, not after.
RESOLVE_DAILY_QUOTA=50
RESOLVE_USER_DAILY_SPEND_USD=1.00

# --- speech transcription (optional) ----------------------------------------
# Without a key /v1/transcribe returns 503 and the app stays on-device.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
TRANSCRIBE_MAX_BYTES=2000000

# --- embeddings -------------------------------------------------------------
# Empty = trigram-only search, which is the current state of the corpus
# (food_embeddings holds 0 rows). Leave blank until M2.
MODEL_PATH=

# --- telemetry --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nutricheck-api

# --- Google sign-in (optional) ----------------------------------------------
# Comma-separated OAuth client IDs a Google ID token may be issued for. Without
# this the button is dead: /v1/auth/google answers 503 and the app falls back to
# email + password.
#
# The Android app's token carries the WEB client ID -- that is what the app's
# GOOGLE_WEB_CLIENT_ID selects. The two must name the same client or Google
# hands over a perfectly good token and this API answers 401. An iOS build
# appends its own iOS client ID here.
#
# Not a secret; a client ID identifies the app rather than authenticating it.
# It is still the ONLY thing stopping any other app's Google tokens from
# signing their holders in here, so it must not be left blank in the belief
# that blank means permissive -- blank means the route is off.
GOOGLE_OAUTH_CLIENT_IDS=
