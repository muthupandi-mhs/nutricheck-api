# Production environment. Copy to .env.deploy ON THE PRODUCTION SERVER:
#
#   cp .env.prod.example .env.deploy
#
# .env.deploy is the filename docker-compose.deploy.yml reads on every machine,
# staging included -- see .env.staging.example for the staging counterpart.
# Never commit the filled copy: .gitignore covers .env.deploy, and that entry is
# the only thing standing between a real JWT secret and the public history of
# this repository.
#
# This file is NOT .env.example. The dev file ships working defaults so a
# checkout boots; every secret here has to be generated. Loading .env.example
# in production would ship the committed dev JWT secrets, which is exactly what
# its own comments warn against.
#
# Only four variables have no default in config.schema.ts: DATABASE_URL,
# REDIS_URL, and the two JWT secrets. The compose file supplies the first two
# from the POSTGRES_* values below, so they are absent here on purpose --
# `environment:` in compose takes precedence over `env_file:` anyway.

# --- compose-level (read by docker-compose.prod.yml itself) -----------------
# These build DATABASE_URL and name the Postgres role. Generate the password:
#   openssl rand -base64 32 | tr -d '/+=' | head -c 40
POSTGRES_USER=nutricheck
POSTGRES_PASSWORD=
POSTGRES_DB=nutricheck

# The domain Caddy will request a certificate for. Must already have an A
# record pointing at this instance's static IP, or issuance fails.
DOMAIN=api.example.com
# Let's Encrypt sends expiry warnings here. A real address you read.
ACME_EMAIL=

# Set to pull a prebuilt image instead of building on the box. Leave unset to
# build locally (see DEPLOY.md -- on 4 GB this needs swap enabled first).
# IMAGE=docker.io/youruser/nutricheck-api:1.0.0

# --- application ------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
DATABASE_POOL_MAX=10

# --- auth -------------------------------------------------------------------
# REQUIRED. Minimum 32 characters, enforced at boot. Generate two DIFFERENT
# ones -- reusing a single secret for both means a stolen access token can be
# replayed as a refresh token:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- AI ---------------------------------------------------------------------
# Leave blank to deploy without the resolver. The API boots fine and only
# /v1/resolve is disabled -- the app stays fully usable, since M1 core works
# with zero AI.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_MS=8000

# Cost ceilings. These are the only thing between a loop in a client and a
# four-figure bill, so set them before the key, not after.
RESOLVE_DAILY_QUOTA=50
RESOLVE_USER_DAILY_SPEND_USD=1.00

# --- speech transcription (optional) ----------------------------------------
# Without a key /v1/transcribe returns 503 and the app stays on-device.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
TRANSCRIBE_MAX_BYTES=2000000

# --- embeddings -------------------------------------------------------------
# Empty = trigram-only search, which is the current state of the corpus
# (food_embeddings holds 0 rows). Leave blank until M2.
MODEL_PATH=

# --- telemetry --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nutricheck-api
