node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

.env
.env.local
.env.*.local
# Real secrets, filled in on a deployed machine. NOT matched by any rule above:
# .env.*.local does not cover .env.staging or .env.prod. The .example templates
# beside them carry no secrets and stay tracked.
.env.staging
.env.prod
.env.deploy
!.env.example
!.env.prod.example
!.env.staging.example

# Private keys -- SSH, Lightsail .pem, anything else. A key sitting in the
# working tree is one `git add -A` away from the public history of this repo,
# and the fix after that is revoking the key, not deleting the commit.
*.pem
*.key
id_rsa
id_ed25519

model/
*.onnx

# Anchored to the repo root. Unanchored, `logs/` matches a directory of that
# name at ANY depth — which silently excluded the whole of
# apps/api/src/modules/logs, the module that owns commit, the day view and the
# batch drain. It had never been committed.
/logs/
*.log
npm-debug.log*

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Mobile app — tracked separately in nutricheck-mobile
nutricheck/

# USDA bulk downloads — large, re-fetchable, not ours to redistribute
.usda/
